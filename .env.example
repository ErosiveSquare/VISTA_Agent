# 复制为 .env 后填入你自己的凭据，或直接 export 到环境变量。
# .env 已被 .gitignore 排除，绝不会进入版本库。
#
# VISTA 只从环境变量读取凭据：如果在 .vista/config.toml 里写了 api_key，
# 启动时会直接报错退出（config.py 的 _scan_secrets 防呆检查）。

VISTA_API_KEY=sk-your-key-here
VISTA_BASE_URL=https://api.openai.com/v1
VISTA_MODEL=gpt-4o-mini
VISTA_WEAK_MODEL=gpt-4o-mini

# provider: http（默认，标准库直连）| openai（官方 SDK）| mock（离线脚本回放）
VISTA_PROVIDER=http
